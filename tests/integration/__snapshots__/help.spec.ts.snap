exports[`help.spec.ts > should output help menu 1`] = `
"
🪄 [33makio[0m

  Free your brain from npm script chaos–Akio helps you search, understand, and  
  run your project scripts fast.                                                

Usage Examples:

  # search root package.json for scripts containing "test"                      
  $ akio @root test                                                             
                                                                                
  # search the second discovered package for scripts containing "build"         
  $ akio @1 build                                                               
                                                                                
  # search exact package name for scripts containing "coverage"                 
  $ akio @client coverage                                                       
                                                                                

CLI Opts

  -d, --descriptions    Do not warn if package.json "scriptDescriptions" are    
                        missing.                                                
  -f, --format          Do not include emoji or color formatting.               
  -h, --help            Display this usage guide.                               
  -i, --input           Do not prompt for an input command.                     
  -p, --pin             Pin the version of this package (skips update available 
                        check).                                                 

  https://npmjs.com/package/@abullard/akio "
`;
